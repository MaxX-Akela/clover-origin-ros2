[connection]
id=clover-ap
uuid=7b0b3c0e-5d0a-4a8e-9a43-6a1f0c2f7d11
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=100

[wifi]
mode=ap
ssid=clover-0000
band=bg

[wifi-security]
key-mgmt=wpa-psk
psk=cloverwifi
proto=rsn
pairwise=ccmp
group=ccmp

[ipv4]
method=shared
address1=192.168.11.1/24

[ipv6]
method=ignore
